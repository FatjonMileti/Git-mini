<%- include('partials/header') %>
<%
  const base = '/' + encodeURIComponent(repo.owner) + '/' + encodeURIComponent(repo.name);
%>
<div class="mb-6">
  <a class="text-sm text-slate-500 hover:text-moss" href="<%= base %>">
    ← <%= repo.owner %>/<%= repo.name %>
  </a>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">Branches</h1>
    <span class="text-sm text-slate-500">
      <%= branches.length %> branch<%= branches.length === 1 ? '' : 'es' %>
    </span>
  </div>
</div>

<%- include('partials/repo-tabs', { repo: repo, active: 'branches' }) %>

<section class="overflow-hidden rounded-lg border border-slate-200 bg-white">
  <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
    <h2 class="font-semibold">All branches</h2>
    <a class="text-sm text-moss hover:underline" href="<%= base %>/commits">View commit history</a>
  </div>

  <% if (branchesError) { %>
    <p class="px-4 py-6 text-sm text-red-700"><%= branchesError %></p>
  <% } else if (!branches.length) { %>
    <p class="px-4 py-6 text-sm text-slate-500">This repository has no branches yet.</p>
  <% } else { %>
    <ul class="divide-y divide-slate-100">
      <% branches.forEach(function (item) { %>
        <li class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50">
          <svg class="mt-1 h-4 w-4 shrink-0 text-slate-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.25 2.25 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z"></path>
          </svg>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <a
                class="font-mono text-sm font-medium text-slate-800 hover:text-moss hover:underline"
                href="<%= base %>?branch=<%= encodeURIComponent(item.name) %>"
              >
                <%= item.name %>
              </a>
              <% if (item.name === defaultBranch) { %>
                <span class="rounded bg-green-50 px-2 py-0.5 text-xs font-medium text-green-800">default</span>
              <% } %>
            </div>
            <p class="mt-1 truncate text-sm text-slate-600"><%= item.subject %></p>
          </div>
          <div class="hidden shrink-0 text-right text-xs text-slate-500 sm:block">
            <p class="font-medium text-slate-700"><%= item.authorName %></p>
            <p><%= item.relativeTime %></p>
          </div>
          <a
            class="shrink-0 self-center rounded border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs text-slate-600 hover:border-moss hover:text-moss"
            href="<%= base %>/commit/<%= item.short %>"
            title="Latest commit"
          >
            <%= item.short %>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<%- include('partials/footer') %>
