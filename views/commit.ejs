<%- include('partials/header') %>
<%
  const base = '/' + encodeURIComponent(repo.owner) + '/' + encodeURIComponent(repo.name);
%>
<div class="mb-6">
  <a class="text-sm text-slate-500 hover:text-moss" href="<%= base %>/commits<%= branch ? '?branch=' + encodeURIComponent(branch) : '' %>">
    ← Commits
  </a>
  <% if (detailError) { %>
    <h1 class="mt-2 text-2xl font-semibold">Commit</h1>
    <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= detailError %></p>
  <% } else { %>
    <h1 class="mt-2 break-words text-2xl font-semibold"><%= commit.subject %></h1>
    <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-slate-500">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full text-xs font-semibold text-white"
        style="background-color: hsl(<%= commit.hue %>, 55%, 42%)"
      >
        <%= commit.initials %>
      </span>
      <span class="font-medium text-slate-800"><%= commit.authorName %></span>
      <span>&lt;<%= commit.authorEmail %>&gt;</span>
      <span>committed <%= commit.dateLabel %></span>
      <span class="rounded border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-xs text-slate-600">
        <%= commit.full %>
      </span>
    </div>
    <% if (commit.parents.length) { %>
      <p class="mt-2 font-mono text-xs text-slate-500">
        parent<%= commit.parents.length > 1 ? 's' : '' %>:
        <% commit.parents.forEach(function (parent, index) { %>
          <a class="text-moss hover:underline" href="<%= base %>/commit/<%= parent %>"><%= parent.slice(0, 7) %></a><%= index < commit.parents.length - 1 ? ', ' : '' %>
        <% }) %>
      </p>
    <% } %>
  <% } %>
</div>

<%- include('partials/repo-tabs', { repo: repo, active: 'commits' }) %>

<% if (!detailError) { %>
  <section class="rounded-lg border border-slate-200 bg-white">
    <div class="flex flex-wrap items-center gap-3 border-b border-slate-200 px-4 py-3 text-sm">
      <span class="font-medium text-slate-700">Commit message</span>
      <span class="ml-auto text-slate-500">
        <%= commit.files.length %> file<%= commit.files.length === 1 ? '' : 's' %> changed
      </span>
      <span class="font-mono text-green-700">+<%= commit.additions %></span>
      <span class="font-mono text-red-700">−<%= commit.deletions %></span>
    </div>
    <pre class="whitespace-pre-wrap px-4 py-4 text-sm text-slate-700"><%= commit.message %></pre>
  </section>

  <section class="mt-6 rounded-lg border border-slate-200 bg-white">
    <h2 class="border-b border-slate-200 px-4 py-3 font-semibold">Changed files</h2>
    <% if (!commit.files.length) { %>
      <p class="px-4 py-6 text-sm text-slate-500">No file changes in this commit.</p>
    <% } else { %>
      <ul class="divide-y divide-slate-100 text-sm">
        <% commit.files.forEach(function (file) { %>
          <li class="flex items-center gap-3 px-4 py-2.5">
            <span class="min-w-0 flex-1 truncate font-mono text-slate-700"><%= file.path %></span>
            <% if (file.binary) { %>
              <span class="text-xs text-slate-400">binary</span>
            <% } else { %>
              <span class="font-mono text-xs text-green-700">+<%= file.additions %></span>
              <span class="font-mono text-xs text-red-700">−<%= file.deletions %></span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white">
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
      <h2 class="font-semibold">Patch</h2>
      <% if (commit.patchTruncated) { %>
        <span class="text-xs text-amber-700">Diff truncated for display</span>
      <% } %>
    </div>
    <% if (!commit.diffLines.length) { %>
      <p class="px-4 py-6 text-sm text-slate-500">No diff available.</p>
    <% } else { %>
      <div class="overflow-x-auto">
        <pre class="min-w-full font-mono text-xs leading-5"><% commit.diffLines.forEach(function (line) { %><span class="<%= line.kind === 'add' ? 'block bg-green-50 text-green-800' : line.kind === 'del' ? 'block bg-red-50 text-red-800' : line.kind === 'hunk' ? 'block bg-sky-50 text-sky-800' : line.kind === 'meta' ? 'block font-semibold text-slate-500' : 'block text-slate-700' %>"><%= line.text || ' ' %></span><% }) %></pre>
      </div>
    <% } %>
  </section>
<% } %>
<%- include('partials/footer') %>
