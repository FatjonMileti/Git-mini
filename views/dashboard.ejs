<%- include('partials/header') %>
<div class="grid gap-8 lg:grid-cols-3">
  <section class="lg:col-span-2">
    <h1 class="text-2xl font-semibold">Repositories</h1>
    <p class="mt-1 text-sm text-slate-500">Public repositories, plus your private ones when signed in.</p>

    <% if (!repositories.length) { %>
      <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
        No repositories yet. Create one to get a clone URL.
      </div>
    <% } else { %>
      <ul class="mt-6 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 bg-white">
        <% repositories.forEach(function (repo) { %>
          <li>
            <a
              class="flex items-start justify-between gap-4 px-4 py-3 hover:bg-slate-50"
              href="/<%= encodeURIComponent(repo.owner) %>/<%= encodeURIComponent(repo.name) %>"
            >
              <div>
                <div class="font-medium text-moss">
                  <%= repo.owner %>/<%= repo.name %>
                </div>
                <p class="mt-1 text-sm text-slate-500">
                  <%= repo.description || 'No description' %>
                </p>
              </div>
              <% if (repo.is_private) { %>
                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">Private</span>
              <% } else { %>
                <span class="rounded bg-green-50 px-2 py-0.5 text-xs text-green-800">Public</span>
              <% } %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <aside>
    <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-lg font-semibold">Create new repository</h2>
      <% if (!currentUser) { %>
        <p class="mt-3 text-sm text-slate-500">
          <a class="text-moss underline" href="/login">Sign in</a> to create a repository.
          Default account: <code class="rounded bg-slate-100 px-1">admin</code> /
          <code class="rounded bg-slate-100 px-1">admin</code>
        </p>
      <% } else { %>
        <form class="mt-4 space-y-3" action="/create" method="post">
          <label class="block text-sm font-medium">
            Name
            <input
              class="mt-1 w-full rounded border border-slate-300 px-3 py-2 font-mono text-sm"
              name="name"
              required
              pattern="[A-Za-z0-9._-]+"
              placeholder="hello-world"
            />
          </label>
          <label class="block text-sm font-medium">
            Description
            <input
              class="mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm"
              name="description"
              placeholder="Optional"
            />
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="is_private" value="1" />
            Private (hidden from other users on the dashboard)
          </label>
          <button
            class="w-full rounded bg-moss px-3 py-2 text-sm font-semibold text-white hover:bg-green-600"
            type="submit"
          >
            Create repository
          </button>
        </form>
      <% } %>
    </div>
  </aside>
</div>
<%- include('partials/footer') %>
