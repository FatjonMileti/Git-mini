<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> · Git Mini</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              ink: '#1b1f23',
              moss: '#2ea44f',
            },
          },
        },
      };
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="bg-ink text-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href="/dashboard" class="text-lg font-semibold tracking-tight">Git Mini</a>
        <nav class="flex items-center gap-4 text-sm">
          <a href="/dashboard" class="text-slate-200 hover:text-white">Dashboard</a>
          <% if (currentUser) { %>
            <a href="/settings/ssh" class="text-slate-200 hover:text-white">SSH keys</a>
            <span class="text-slate-400"><%= currentUser.username %></span>
            <form action="/logout" method="post">
              <button class="rounded bg-slate-700 px-3 py-1 hover:bg-slate-600" type="submit">
                Sign out
              </button>
            </form>
          <% } else { %>
            <a href="/login" class="hover:text-white">Sign in</a>
            <a
              href="/register"
              class="rounded bg-moss px-3 py-1 font-medium text-white hover:bg-green-600"
            >
              Register
            </a>
          <% } %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div
          class="mb-6 rounded-md border px-4 py-3 text-sm <%= flash.type === 'error' ? 'border-red-200 bg-red-50 text-red-800' : 'border-green-200 bg-green-50 text-green-800' %>"
        >
          <%= flash.message %>
        </div>
      <% } %>
