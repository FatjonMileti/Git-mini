<%- include('partials/header') %>
<div class="mb-6">
  <a class="text-sm text-slate-500 hover:text-moss" href="/dashboard">← Dashboard</a>
  <div class="mt-2 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-semibold">
      <%= repo.owner %>/<span class="text-moss"><%= repo.name %></span>
    </h1>
    <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
      <%= repo.is_private ? 'Private' : 'Public' %>
    </span>
  </div>
  <% if (repo.description) { %>
    <p class="mt-2 text-slate-600"><%= repo.description %></p>
  <% } %>
</div>

<section class="mb-6 rounded-lg border border-slate-200 bg-white p-4">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Clone</h2>
  <p class="mt-2 font-mono text-sm break-all rounded bg-slate-100 px-3 py-2"><%= cloneUrl %></p>
  <pre class="mt-3 overflow-x-auto rounded bg-ink p-3 text-xs text-slate-100">git clone <%= cloneUrl %>
cd <%= repo.name %>
echo "# <%= repo.name %>" > README.md
git add README.md
git commit -m "Initial commit"
git push -u origin main</pre>
</section>

<section class="rounded-lg border border-slate-200 bg-white">
  <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
    <h2 class="font-semibold">Files</h2>
    <span class="text-sm text-slate-500"><%= branch ? ('branch: ' + branch) : 'empty repository' %></span>
  </div>
  <% if (treeError) { %>
    <p class="px-4 py-6 text-sm text-red-700"><%= treeError %></p>
  <% } else if (!files.length) { %>
    <p class="px-4 py-6 text-sm text-slate-500">
      No commits yet. Clone the URL above, commit a file, and push to populate this tree.
    </p>
  <% } else { %>
    <ul class="divide-y divide-slate-100">
      <% files.forEach(function (file) { %>
        <li class="flex items-center justify-between px-4 py-2 text-sm">
          <span class="font-mono">
            <%= file.isTree ? '📁' : '📄' %>
            <%= file.name %><%= file.isTree ? '/' : '' %>
          </span>
          <span class="text-slate-400">
            <%= file.isTree ? 'tree' : (file.size + ' bytes') %>
          </span>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
<%- include('partials/footer') %>
