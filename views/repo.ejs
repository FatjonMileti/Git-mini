<%- include('partials/header') %>
<%
  const base = '/' + encodeURIComponent(repo.owner) + '/' + encodeURIComponent(repo.name);
  const q = (pathValue, extra) => {
    const params = new URLSearchParams();
    if (branch) params.set('branch', branch);
    if (typeof extra === 'object' && extra) {
      Object.entries(extra).forEach(([key, value]) => {
        if (value) params.set(key, value);
      });
    }
    if (pathValue) params.set('path', pathValue);
    const qs = params.toString();
    return qs ? '?' + qs : '';
  };
  const blobHref = (pathValue) => {
    const params = new URLSearchParams();
    if (branch) params.set('branch', branch);
    params.set('path', pathValue);
    return base + '/blob?' + params.toString();
  };
  const parentPath = path ? path.split('/').slice(0, -1).join('/') : '';
%>
<div class="mb-6">
  <div class="flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-semibold">
      <span class="text-slate-500"><%= repo.owner %> /</span> <%= repo.name %>
    </h1>
    <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
      <%= repo.is_private ? 'Private' : 'Public' %>
    </span>
    <a
      class="ml-auto rounded border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
      href="#clone"
    >
      Clone
    </a>
  </div>
  <% if (repo.description) { %>
    <p class="mt-2 text-slate-600"><%= repo.description %></p>
  <% } %>
</div>

<%- include('partials/repo-tabs', { repo: repo, active: 'code' }) %>

<section class="rounded-lg border border-slate-200 bg-white">
  <div class="flex flex-wrap items-center gap-3 border-b border-slate-200 px-4 py-3">
    <%- include('partials/branch-select', {
      branches: branches,
      branch: branch,
      defaultBranch: defaultBranch,
      branchAction: branchAction,
      path: path
    }) %>
    <nav class="flex min-w-0 flex-wrap items-center gap-1 text-sm text-slate-500">
      <a class="font-medium text-moss hover:underline" href="<%= base + q('', null) %>"><%= repo.name %></a>
      <% crumbs.forEach(function (crumb) { %>
        <span class="text-slate-300">/</span>
        <a class="hover:text-moss hover:underline" href="<%= base + q(crumb.path, null) %>"><%= crumb.name %></a>
      <% }) %>
    </nav>
    <span class="ml-auto text-xs text-slate-400">
      <%= commitTotal || 0 %> commit<%= commitTotal === 1 ? '' : 's' %>
    </span>
  </div>

  <% if (latestCommit) { %>
    <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 bg-slate-50 px-4 py-2.5 text-sm">
      <span
        class="flex h-7 w-7 items-center justify-center rounded-full text-[11px] font-semibold text-white"
        style="background-color: hsl(<%= latestCommit.hue %>, 55%, 42%)"
      >
        <%= latestCommit.initials %>
      </span>
      <span class="font-medium text-slate-800"><%= latestCommit.authorName %></span>
      <a
        class="min-w-0 flex-1 truncate text-slate-600 hover:text-moss hover:underline"
        href="<%= base %>/commit/<%= latestCommit.full %>"
      >
        <%= latestCommit.subject %>
      </a>
      <a class="font-mono text-xs text-slate-500 hover:text-moss" href="<%= base %>/commit/<%= latestCommit.full %>">
        <%= latestCommit.short %>
      </a>
      <span class="text-xs text-slate-400"><%= latestCommit.relativeTime %></span>
    </div>
  <% } %>

  <% if (treeError) { %>
    <p class="px-4 py-6 text-sm text-red-700"><%= treeError %></p>
  <% } else if (!entries.length) { %>
    <div class="px-4 py-10 text-center text-sm text-slate-500">
      This repository is empty. Push your first commit to get started.
    </div>
  <% } else { %>
    <ul class="divide-y divide-slate-100">
      <% if (path) { %>
        <li>
          <a
            class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-600 hover:bg-slate-50"
            href="<%= base + q(parentPath, null) %>"
          >
            <svg class="h-4 w-4 text-slate-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M3.75 3a.75.75 0 0 0-.75.75v2.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75v-2.5a.75.75 0 0 0-.75-.75h-1.5Zm0 1.5h1.5v1h-1.5v-1ZM3.75 9a.75.75 0 0 0-.75.75v2.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75v-2.5a.75.75 0 0 0-.75-.75h-1.5Zm0 1.5h1.5v1h-1.5v-1ZM8 9.75A.75.75 0 0 1 8.75 9h4.5a.75.75 0 0 1 0 1.5h-4.5A.75.75 0 0 1 8 9.75ZM8 5.25A.75.75 0 0 1 8.75 4.5h4.5a.75.75 0 0 1 0 1.5h-4.5A.75.75 0 0 1 8 5.25Z"></path>
            </svg>
            ..
          </a>
        </li>
      <% } %>
      <% entries.forEach(function (entry) { %>
        <li>
          <% if (entry.isTree) { %>
            <a
              class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-slate-50"
              href="<%= base + q(path ? path + '/' + entry.name : entry.name, null) %>"
            >
              <svg class="h-4 w-4 text-sky-500" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"></path>
              </svg>
              <span class="font-medium text-slate-800"><%= entry.name %></span>
            </a>
          <% } else if (entry.isSubmodule) { %>
            <div class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-600">
              <svg class="h-4 w-4 text-slate-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"></path>
              </svg>
              <span class="font-medium text-slate-800"><%= entry.name %></span>
              <span class="text-xs text-slate-400">submodule @ <%= entry.oid.slice(0, 7) %></span>
            </div>
          <% } else { %>
            <a
              class="flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-slate-50"
              href="<%= blobHref(path ? path + '/' + entry.name : entry.name) %>"
            >
              <svg class="h-4 w-4 text-slate-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"></path>
              </svg>
              <span class="font-medium text-slate-800"><%= entry.name %></span>
              <span class="ml-auto text-xs text-slate-400">
                <% if (entry.size >= 1024) { %><%= (entry.size / 1024).toFixed(1) %> KB<% } else { %><%= entry.size || 0 %> B<% } %>
              </span>
            </a>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<% if (readme) { %>
  <section class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white">
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
      <h2 class="flex items-center gap-2 font-semibold">
        <svg class="h-4 w-4 text-slate-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v12.5A1.75 1.75 0 0 1 14.25 16H1.75A1.75 1.75 0 0 1 0 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25V1.75a.25.25 0 0 0-.25-.25Z"></path>
        </svg>
        <%= readme.name %>
      </h2>
      <a class="text-sm text-moss hover:underline" href="<%= blobHref(readme.name) %>">View file</a>
    </div>
    <pre class="max-h-96 overflow-auto whitespace-pre-wrap px-4 py-4 font-mono text-sm text-slate-700"><%= readme.content %></pre>
  </section>
<% } %>

<section class="mt-6 rounded-lg border border-slate-200 bg-white">
  <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
    <h2 class="font-semibold">Recent commits</h2>
    <a
      class="text-sm text-moss hover:underline"
      href="<%= base %>/commits<%= q('', null) %>"
    >
      View all
    </a>
  </div>
  <%- include('partials/commit-groups', { groups: commitGroups, repo: repo }) %>
</section>

<section id="clone" class="mt-6 rounded-lg border border-slate-200 bg-white p-4">
  <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Clone this repository</h2>
  <p class="mt-2 break-all rounded bg-slate-100 px-3 py-2 font-mono text-sm"><%= cloneUrl %></p>
  <div class="mt-3 grid gap-3 text-sm text-slate-600 sm:grid-cols-2">
    <div>
      <p class="font-medium text-slate-700">Fresh clone</p>
      <pre class="mt-1 overflow-x-auto rounded bg-slate-900 px-3 py-2 font-mono text-xs text-slate-100">git clone <%= cloneUrl %></pre>
    </div>
    <div>
      <p class="font-medium text-slate-700">Push an existing project</p>
      <pre class="mt-1 overflow-x-auto rounded bg-slate-900 px-3 py-2 font-mono text-xs text-slate-100">git remote add origin <%= cloneUrl %>
git push -u origin main</pre>
    </div>
  </div>
</section>

<% if (isOwner) { %>
  <section class="mt-10 rounded-lg border border-red-200 bg-red-50 p-5">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-red-800">Danger zone</h2>
    <p class="mt-2 text-sm text-red-800">
      Deleting <span class="font-mono"><%= repo.owner %>/<%= repo.name %></span> removes the
      database row and the bare Git directory on disk. This cannot be undone.
    </p>
    <form
      class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end"
      method="post"
      action="<%= base %>/delete"
      onsubmit="return confirm('Delete this repository permanently?');"
    >
      <label class="block flex-1 text-sm font-medium text-red-900">
        Type <span class="font-mono"><%= repo.name %></span> to confirm
        <input
          class="mt-1 w-full rounded border border-red-300 bg-white px-3 py-2 font-mono text-sm"
          name="confirm"
          required
          autocomplete="off"
          placeholder="<%= repo.name %>"
        />
      </label>
      <button
        class="rounded bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700"
        type="submit"
      >
        Delete repository
      </button>
    </form>
  </section>
<% } %>
<%- include('partials/footer') %>
