<%- include('partials/header') %>
<div class="mb-2">
  <a class="text-sm text-slate-500 hover:text-moss" href="/dashboard">&larr; Dashboard</a>
  <h1 class="mt-2 text-2xl font-semibold">SSH keys</h1>
  <p class="mt-1 text-sm text-slate-500">
    Add the public keys that may clone and push over SSH.
  </p>
</div>

<%- include('partials/settings-tabs', { section: section }) %>

<div class="grid gap-6 lg:grid-cols-2">
  <section class="rounded-lg border border-slate-200 bg-white">
    <div class="border-b border-slate-200 px-4 py-3">
      <h2 class="font-semibold">Your keys</h2>
    </div>

    <% if (!keys.length) { %>
      <p class="px-4 py-6 text-sm text-slate-500">No SSH keys yet.</p>
    <% } else { %>
      <ul class="divide-y divide-slate-100">
        <% keys.forEach(function (key) { %>
          <li class="flex items-start gap-3 px-4 py-3">
            <svg class="mt-1 h-4 w-4 shrink-0 text-slate-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0a4.5 4.5 0 0 0-4.5 4.5v1.75A2.25 2.25 0 0 0 2 8.5v5.25c0 1.243 1.007 2.25 2.25 2.25h7.5A2.25 2.25 0 0 0 14 13.75V8.5a2.25 2.25 0 0 0-1.5-2.25V4.5A4.5 4.5 0 0 0 8 0ZM5 4.5a3 3 0 1 1 6 0v1.5H5V4.5Zm-1.5 4h9a.75.75 0 0 1 .75.75v5a.75.75 0 0 1-.75.75h-9a.75.75 0 0 1-.75-.75v-5a.75.75 0 0 1 .75-.75Z"></path>
            </svg>
            <div class="min-w-0 flex-1">
              <p class="font-medium text-slate-800"><%= key.title %></p>
              <p class="mt-0.5 break-all font-mono text-xs text-slate-500"><%= key.fingerprint %></p>
              <p class="mt-1 text-xs text-slate-400">
                <%= key.key_type %> · added <%= key.created_at %> UTC
              </p>
            </div>
            <form method="post" action="/settings/ssh/<%= key.id %>/delete">
              <button
                class="rounded border border-red-200 px-2.5 py-1 text-xs font-medium text-red-700 hover:bg-red-50"
                type="submit"
                onclick="return confirm('Remove this SSH key?');"
              >
                Remove
              </button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-lg font-semibold">Add a key</h2>
    <p class="mt-1 text-sm text-slate-500">
      Paste the contents of your <code class="rounded bg-slate-100 px-1">~/.ssh/id_ed25519.pub</code>
      (or <code class="rounded bg-slate-100 px-1">id_rsa.pub</code>) file.
    </p>

    <% if (!sshEnabled) { %>
      <p class="mt-4 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        The SSH listener is disabled on this server.
      </p>
    <% } %>

    <form class="mt-4 space-y-3" action="/settings/ssh" method="post">
      <label class="block text-sm font-medium">
        Title
        <input
          class="mt-1 w-full rounded border border-slate-300 px-3 py-2 text-sm"
          name="title"
          maxlength="80"
          placeholder="Work laptop"
        />
      </label>
      <label class="block text-sm font-medium">
        Public key
        <textarea
          class="mt-1 h-28 w-full rounded border border-slate-300 px-3 py-2 font-mono text-xs"
          name="public_key"
          required
          spellcheck="false"
          placeholder="ssh-ed25519 AAAA... you@example.com"
        ></textarea>
      </label>
      <button
        class="w-full rounded bg-moss px-3 py-2 text-sm font-semibold text-white hover:bg-green-600"
        type="submit"
      >
        Add SSH key
      </button>
    </form>

    <div class="mt-6 border-t border-slate-200 pt-4">
      <h3 class="text-sm font-semibold text-slate-700">Clone over SSH</h3>
      <pre class="mt-2 overflow-x-auto rounded bg-slate-900 px-3 py-2 font-mono text-xs text-slate-100">git clone ssh://git@&lt;host&gt;<%= Number(sshPort) === 22 ? '' : ':' + sshPort %>/&lt;owner&gt;/&lt;repo&gt;.git</pre>
      <p class="mt-2 text-xs text-slate-500">
        Password authentication works too: use
        <code class="rounded bg-slate-100 px-1">ssh://&lt;username&gt;@&lt;host&gt;<%= Number(sshPort) === 22 ? '' : ':' + sshPort %>/&lt;owner&gt;/&lt;repo&gt;.git</code>
        with your web account password.
      </p>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
